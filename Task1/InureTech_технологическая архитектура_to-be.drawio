        <mxCell id="c102" value="HC: HAProxy -&gt; Patroni&lt;br&gt;GET :8008/primary, /replica&lt;br&gt;каждые 3 c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=4 3;strokeColor=#E5262A;fontColor=#E5262A;endArrow=open;startArrow=none;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c32" target="c40" edge="1">
