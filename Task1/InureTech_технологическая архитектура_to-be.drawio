        <mxCell id="c104" value="Потоковая репликация (asynchronous)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#5282FF;fontColor=#1A4FCC;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="c40" target="c74" edge="1">
          <mxGeometry relative="1" as="geometry">
