              <mxPoint x="2040" y="1470" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c105" value="Patroni: leader lock&lt;br&gt;TTL 30 c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=4 3;strokeColor=#E5262A;fontColor=#E5262A;endArrow=open;startArrow=none;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="c40" target="c37" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c106" value="Patroni: leader lock&lt;br&gt;TTL 30 c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=4 3;strokeColor=#E5262A;fontColor=#E5262A;endArrow=open;startArrow=none;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="c57" target="c54" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c107" value="Patroni: leader lock&lt;br&gt;TTL 30 c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=4 3;strokeColor=#E5262A;fontColor=#E5262A;endArrow=open;startArrow=none;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="c74" target="c71" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c108" value="Raft" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c37" target="c54" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c109" value="Raft" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c54" target="c71" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c110" value="pgBackRest: backup + WAL archive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;" parent="1" source="c40" target="c78" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="616" y="1540" />
              <mxPoint x="724" y="1540" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c111" value="blackbox: GET https://insuretech.ru/healthz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=4 3;strokeColor=#E5262A;fontColor=#E5262A;endArrow=open;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="c80" target="c16" edge="1">
          <mxGeometry x="0.3" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2400" y="1674" />
              <mxPoint x="2400" y="274" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c112" value="&lt;b&gt;1. Масштабирование&lt;/b&gt;&lt;br&gt;Горизонтальное масштабирование: сервисы stateless, HPA по CPU/RAM/RPS + Cluster Autoscaler нод в каждой зоне. Вертикальное - только для БД (50 GB данных помещаются на одном узле, увеличиваем vCPU/RAM ВМ). Нагрузку на чтение (поиск 50+ RPS) снимаем ro-репликами через HAProxy :5001 и кешем тарифов.&lt;br&gt;&lt;b&gt;Дополнительные зоны нужны&lt;/b&gt;: одна зона - единая точка отказа, 99,9% (до 8,8 ч простоя в год, 43 мин в месяц) при RTO 45 мин требует N+1 по зонам. Используем 3 зоны региона: каждая зона несет до 50% пиковой нагрузки, отказ одной зоны не снижает доступность." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2440" y="20" width="520" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c113" value="&lt;b&gt;2a. Kubernetes: один растянутый кластер&lt;/b&gt;&lt;br&gt;Выбран Managed K8s региональный кластер на 3 зоны, а не независимые кластеры: зоны одного региона связаны каналом с задержкой порядка 1 мс, мастера (etcd) уже отказоустойчивы и управляются провайдером, один набор манифестов и один CI/CD, балансировка между зонами встроена (ALB + Service), нет лишнего GSLB и синхронизации конфигураций. Риск отказа всего региона закрывается DR-планом из бэкапов (п. 2d)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2440" y="285" width="520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c114" value="&lt;b&gt;2b. Балансировка и health check&lt;/b&gt;&lt;br&gt;DNS -&gt; один anycast IP ALB -&gt; узлы ALB в 3 зонах -&gt; Ingress в каждой зоне -&gt; Service -&gt; pod. Статика Web отдается из CDN рядом с пользователем - одинаковое время загрузки во всех регионах; API - только JSON, без зависимости от географии.&lt;br&gt;Health checks (красные пунктирные линии): ALB -&gt; Ingress /healthz; K8s liveness/readiness; HAProxy -&gt; Patroni :8008; Patroni -&gt; etcd (leader lock); CDN -&gt; origin; внешний blackbox-мониторинг." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2440" y="490" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c115" value="&lt;b&gt;2c. Фейловер-стратегия: Active-Active&lt;/b&gt;&lt;br&gt;Все 3 зоны обслуживают трафик одновременно. При отказе зоны ALB по health check за 6-10 c перестает слать в нее запросы, клиент повторяет запрос (идемпотентные GET / Idempotency-Key для POST), HPA и Cluster Autoscaler добирают мощность в оставшихся зонах. Для клиента переключение прозрачно (тот же IP / DNS-имя)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2440" y="705" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c116" value="&lt;b&gt;2d. Конфигурация БД: PostgreSQL + Patroni&lt;/b&gt;&lt;br&gt;3 узла в 3 зонах: Leader (A), synchronous replica (B), asynchronous replica (D); etcd из 3 узлов; HAProxy определяет Leader через REST API Patroni.&lt;br&gt;RPO 15 мин: синхронная реплика - RPO = 0 при отказе Leader; WAL archive в Object Storage каждые =&lt; 60 c - RPO =&lt; 1 мин даже при потере всех узлов.&lt;br&gt;RTO 45 мин: автоматический failover Patroni - 30-60 c; полное восстановление из pgBackRest (full + WAL, 50 GB) - около 20-30 мин.&lt;br&gt;DR: ежеквартальная проверка восстановления из бэкапа." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2440" y="880" width="520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c117" value="&lt;b&gt;3. Шардирование БД не применяется&lt;/b&gt;&lt;br&gt;50 GB данных и 50 + 10 RPS (x несколько после рекламы) обслуживаются одним Leader с репликами на чтение. Шардирование усложнит транзакции и запросы без выигрыша. Резерв роста: вынос схем сервисов в отдельные кластеры Patroni (по сервису), затем партиционирование таблиц заявок по дате; шардирование (например, Citus по client_id) - только при росте до терабайт." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2440" y="1125" width="520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c118" value="&lt;b&gt;Мониторинг (проблема 3)&lt;/b&gt;&lt;br&gt;Команда узнает о сбое по алерту за 1-2 минуты, а не от пользователей: SLO-алерты по доступности и latency, lag репликации, lag Kafka-потребителей, статус Patroni." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="2440" y="1330" width="520" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
